{
  "$schema": "/etc/swaync/config.schema.json",
  "positionX": "right",
  "positionY": "top",
  "control-center-width": 340,
  "control-center-margin-top": 8,
  "control-center-margin-right": 8,
  "control-center-margin-bottom": 8,
  "notification-window-width": 300,
  "transition-length": 150,
  "timeout": 2,
  "timeout-low": 2,
  "timeout-critical": 0,

  "widgets": [
    "title",
    "dnd",
    "mpris",
    "volume",
    "backlight",
    "buttons-grid",
    "notifications"
  ],
  "widget-config": {
    "title": {
      "text": "Control Center",
      "clear-all-button": true,
      "button-text": "󰎟 Clear All"
    },
    "dnd": {
      "text": "Do Not Disturb"
    },
    "volume": {
      "label": "󰕾",
      "show-per-app": true
    },
    "backlight": {
      "label": "󰃠"
    },
    "buttons-grid": {
      "actions": [
        {
          "label": "󰖩 Wifi",
          "command": "nm-connection-editor"
        },
        {
          "label": "󰂯 Bluetooth",
          "type": "toggle",
          "command": "rfkill toggle bluetooth",
          "update-command": "sh -c 'rfkill list bluetooth | grep -q \"Soft blocked: no\" && echo true || echo false'",
          "interval": 1
        },
        {
          "label": " Airplane",
          "type": "toggle",
          "command": "bash ~/.config/hypr/scripts/airplane_mode.sh",
          "update-command": "sh -c 'nmcli radio wifi | grep -q \"disabled\" && echo true || echo false'",
          "interval": 1
        },
        {
          "label": "󰛨 Night",
          "type": "toggle",
          "command": "bash -c '~/.config/hypr/scripts/night_light.sh'",
          "update-command": "pgrep -x wlsunset > /dev/null && echo true || echo false",
          "interval": 1
        },
        {
          "label": "󰓅 Performace",
          "type": "toggle",
          "command": "bash -c '~/.config/hypr/scripts/power_mode.sh performance'",
          "update-command": "powerprofilesctl get | grep -q performance && echo true || echo false",
          "interval": 1
        },
        {
          "label": "󰾆 Balanced",
          "type": "toggle",
          "command": "bash -c '~/.config/hypr/scripts/power_mode.sh balanced'",
          "update-command": "powerprofilesctl get | grep -q balanced && echo true || echo false",
          "interval": 1
        },
        {
          "label": "󰊰 Saver",
          "type": "toggle",
          "command": "bash -c '~/.config/hypr/scripts/power_mode.sh power-saver'",
          "update-command": "powerprofilesctl get | grep -q power-saver && echo true || echo false",
          "interval": 1
        },
        {
          "label": "󰌵 Power Saved",
          "type": "toggle",
          "command": "bash -c '~/.config/hypr/scripts/power_save_toggle.sh'",
          "update-command": "powerprofilesctl get | grep -q power-saver && echo true || echo false",
          "interval": 1
        },
        {
          "label": "󰍹 Monitor",
          "command": "nwg-displays"
        },
        {
          "label": "󰏘 Theme",
          "command": "nwg-look"
        }
      ]
    }
  }
}
